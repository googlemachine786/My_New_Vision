# Template for backend/.env when running against deploy/compose.yml.
# Copy these values into backend/.env (which is gitignored).
#
# Ports match the compose file (Postgres 54322, Redis 6379, Mailpit 1025).
# Storage stays on cloud Supabase — paste real values from the team's
# secret store.

NODE_ENV=development
PORT=3001

# --- Local infrastructure (deploy/compose.yml) -------------------------
# Reachable from the HOST as localhost:<published-port>.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379

# Mailpit (SMTP catcher) — view captured emails at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Visionary <noreply@visionary.local>

# --- Cloud Supabase Storage --------------------------------------------
# Talks to a real Supabase project (separate bucket per env recommended).
# Paste service-role key from the Supabase dashboard.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Frontend ----------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- JWT ---------------------------------------------------------------
# Generate a fresh local-only secret: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Google OAuth ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- AI providers ------------------------------------------------------
OPENAI_API_KEY=
CLAUDE_API_KEY=
