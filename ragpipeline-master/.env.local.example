# Visionary RAG Pipeline - Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Database connection (for direct psycopg access)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ============================================================
# GCP / VERTEX AI (Optional - for embeddings)
# ============================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Vertex AI Embedding model
# OPTIMIZED: Use minilm for CBSE Science (11% better than multilingual-e5)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSION=384
EMBED_TASK_TYPE=RETRIEVAL_DOCUMENT

# ============================================================
# OLLAMA (Local Development - Optional)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2:3b

# LLM Generation parameters (optimized from grid search)
LLM_TEMPERATURE=0.75
MAX_TOKENS=150

# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_MODE=local  # local or production
LOG_LEVEL=info  # debug, info, warning, error
ENVIRONMENT=development

# Request timeout
REQUEST_TIMEOUT=450ms

# ============================================================
# RETRIEVAL SETTINGS (Optimized from grid search - see RAG_PIPELINE_AUDIT_REPORT.md)
# ============================================================
# Top-performing configuration: 0.8386 composite score
TOP_K=5
TOP_K_DENSE=100
TOP_K_SPARSE=100
TOP_K_RRF=10
RRF_K=60.0

# Similarity threshold (critical: 0.36 optimal, not 0.5-0.7)
SIMILARITY_THRESHOLD=0.36

# Retrieval strategy: dense outperforms hybrid for CBSE Science
RETRIEVAL_STRATEGY=dense

# BM25 k1 (only used if RETRIEVAL_STRATEGY=hybrid)
BM25_K1=2.05

# ============================================================
# CHUNKING SETTINGS (Optimized from grid search)
# ============================================================
# Optimal: 400 chars with 150 overlap (37.5%)
# Previous defaults (1500/512/77) were suboptimal
PARENT_MAX_CHARS=400
CHILD_MAX_CHARS=400
CHILD_OVERLAP=150

# Cache settings
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=10000

# Session settings
SESSION_TTL_SECONDS=2100  # 35 minutes

# ============================================================
# JWT CONFIGURATION
# ============================================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# ============================================================
# REDIS (Optional - Supabase handles sessions)
# ============================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50

# ============================================================
# FEATURE FLAGS
# ============================================================
USE_LOCAL_EMBEDDINGS=false
USE_LOCAL_LLM=false
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_MONITORING=false

# ============================================================
# RERANKER SERVICE
# ============================================================
RERANKER_SERVICE_URL=http://localhost:8085
