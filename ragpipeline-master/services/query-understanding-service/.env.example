# Google Cloud Project ID (required)
GEMINI_PROJECT_ID=your-gcp-project-id

# Google Cloud location for Vertex AI
GEMINI_LOCATION=us-central1

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Generation parameters
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=512
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# Request timeout for Gemini API calls
GEMINI_REQUEST_TIMEOUT=30s

# Retry configuration for LLM calls
GEMINI_MAX_RETRIES=3

# Rate limiting for LLM API calls (prevents cost explosion)
GEMINI_RATE_LIMIT=10        # Requests per second
GEMINI_RATE_BURST=20        # Burst size

# Path to service account JSON key file
# If not set, uses Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server configuration
PORT=8083
READ_TIMEOUT=10s
WRITE_TIMEOUT=60s           # Increased for LLM requests
IDLE_TIMEOUT=60s

# Maximum conversation history turns (max 10)
MAX_HISTORY_TURNS=10

# Prompt template versions for A/B testing
PROMPT_REWRITE_VERSION=v1
PROMPT_PARSE_FILTERS_VERSION=v1
PROMPT_CLASSIFY_INTENT_VERSION=v1
