# API Gateway Configuration
# Copy this file to .env and update with your values

# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=120s
SERVER_IDLE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=40s

# Downstream Service URLs
EMBEDDING_SERVICE_URL=http://localhost:8081
VECTOR_SEARCH_SERVICE_URL=http://localhost:8082
QUERY_UNDERSTANDING_URL=http://localhost:8083
LLM_SERVICE_URL=http://localhost:8084

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# JWT Authentication
JWT_SECRET=change-me-in-production

# Rate Limiting
RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=20

# Timeouts (must be positive, TOTAL must be > sum of others)
TIMEOUT_EMBEDDING=10s
TIMEOUT_VECTOR_SEARCH=15s
TIMEOUT_QUERY_UNDERSTANDING=5s
TIMEOUT_LLM=60s
TIMEOUT_TOTAL=120s

# ==========================================
# CAG (Cache Augmented Generation) Configuration
# ==========================================
# Master toggle for CAG
CAG_ENABLED=true

# Layer 1: Exact Match Cache (already exists)
EXACT_CACHE_TTL=1h
EXACT_CACHE_MAX_SIZE=1000

# Layer 2: Semantic Cache
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL=6h
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_SIZE=5000

# Layer 3: Embedding Cache (uses embedding service Redis)
EMBEDDING_SERVICE_REDIS_URL=redis://localhost:6379/0
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=24h
EMBEDDING_CACHE_MAX_SIZE=10000

# Layer 5: Template Cache
TEMPLATE_CACHE_ENABLED=true
TEMPLATE_CACHE_TTL=12h
TEMPLATE_CACHE_MAX_SIZE=500

# Cache Invalidation
CACHE_INVALIDATE_ON_INGEST=true
CACHE_AUTO_INVALIDATE_LOW_QUALITY=false
CACHE_MIN_QUALITY_SCORE=0.7

# ==========================================
# WebSocket Configuration
# ==========================================
# Comma-separated list of allowed origins (empty = allow all in dev)
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Ping interval for keepalive (default: 30s)
WS_PING_INTERVAL=30s
# Pong wait timeout (default: 60s)
WS_PONG_WAIT=60s
# Write wait timeout for sending messages (default: 10s)
WS_WRITE_WAIT=10s
