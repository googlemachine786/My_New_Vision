# Embedding Service Configuration
# Copy this file to .env or .env.local and fill in the required values

# ==========================================
# Server Configuration
# ==========================================
PORT=8081
ENVIRONMENT=development
READ_TIMEOUT=10s
WRITE_TIMEOUT=35s
IDLE_TIMEOUT=120s

# ==========================================
# Google Cloud / Vertex AI Configuration
# ==========================================
# Required: Your GCP project ID
VERTEX_PROJECT=your-gcp-project-id

# Required: GCP region (us-central1, asia-south1, etc.)
VERTEX_LOCATION=us-central1

# Optional: Embedding model (default: text-embedding-005)
VERTEX_MODEL=text-embedding-005

# Optional: Embedding dimension (default: 768 for text-embedding-005)
VERTEX_DIMENSION=768

# Optional: Request timeout for Vertex AI API calls
VERTEX_TIMEOUT=30s

# ==========================================
# Task Type Configuration
# ==========================================
# Task type for document embeddings (indexing)
DOCUMENT_TASK_TYPE=RETRIEVAL_DOCUMENT

# Task type for query embeddings (search)
QUERY_TASK_TYPE=RETRIEVAL_QUERY

# ==========================================
# Retry Configuration
# ==========================================
# Maximum number of retry attempts (1-10)
MAX_RETRIES=5

# Initial backoff duration
INITIAL_BACKOFF=100ms

# Maximum backoff duration
MAX_BACKOFF=5s

# ==========================================
# Request Limits
# ==========================================
# Maximum number of texts per batch request (1-10)
MAX_TEXTS_PER_BATCH=5

# Maximum text length in characters (100-100000)
MAX_TEXT_LENGTH=20000

# ==========================================
# Observability (OpenTelemetry)
# ==========================================
# OTLP exporter endpoint (leave empty to disable tracing)
# Example: localhost:4317 for local collector
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=embedding-service
OTEL_SAMPLE_RATE=1.0

# Logging level: debug, info, warn, error
LOG_LEVEL=debug

# ==========================================
# GCP Authentication
# ==========================================
# For local development, authenticate with:
#   gcloud auth application-default login
#
# For production, set one of:
#   - GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#   - Or run on GCP infrastructure (Cloud Run, GKE, Compute Engine)
#
# The service account must have:
#   - roles/aiplatform.user (Vertex AI User)
