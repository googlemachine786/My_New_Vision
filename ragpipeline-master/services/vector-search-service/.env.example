# Vector Search Service Configuration
# Copy this file to .env or .env.local and fill in the required values

# ==========================================
# Server Configuration
# ==========================================
PORT=8082
ENVIRONMENT=development
READ_TIMEOUT=10s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s

# ==========================================
# Database Configuration (Required)
# ==========================================
# PostgreSQL connection string with pgvector/ScaNN support
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s

# ==========================================
# Search Configuration
# ==========================================
DEFAULT_TOP_K=10
MAX_TOP_K=100
QUERY_TIMEOUT=30s
SIMILARITY_THRESHOLD=0.36

# ==========================================
# Dense Search Configuration
# ==========================================
DENSE_CHILD_TABLE=child_chunks
DENSE_PARENT_TABLE=parent_chunks
EMBEDDING_COLUMN=embedding
EMBEDDING_DIM=768

# ==========================================
# Sparse Search Configuration
# ==========================================
SPARSE_TABLE=parent_chunks
KEYWORDS_COLUMN=extracted_keywords
SPARSE_OVERLAP_LIMIT=200

# ==========================================
# RRF (Reciprocal Rank Fusion) Configuration
# ==========================================
# k=60 is the empirically-proven default
RRF_K=60.0
RRF_DENSE_WEIGHT=1.0
RRF_SPARSE_WEIGHT=1.0

# ==========================================
# Performance / Debug
# ==========================================
ENABLE_EXPLAIN_ANALYZE=false
ENABLE_QUERY_METRICS=true

# ==========================================
# Observability (OpenTelemetry - Optional)
# ==========================================
# OTLP exporter endpoint (leave empty to disable tracing)
# Example: localhost:4317 for local collector
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vector-search-service
OTEL_SAMPLE_RATE=1.0

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ==========================================
# CAG Search Results Cache Configuration
# ==========================================
REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL=30m
SEARCH_CACHE_MAX_SIZE=3000
